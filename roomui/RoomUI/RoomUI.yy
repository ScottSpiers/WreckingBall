        {"$GMRFlexPanel":"","%Name":"pnl_email_End","alignItems":2,"children":[
            {"$GMRTextItem":"v3","%Name":"text_201702D4","alignment":0,"charSpacing":0.0,"colour":4279834905,"flexProperties":{"$InstanceFlexProps":"v1","anchor":0,"resourceType":"InstanceFlexProps",},"fontId":{"name":"fnt_Serif","path":"fonts/fnt_Serif/fnt_Serif.yy",},"frameH":600.0,"frameW":1080.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_201702D4","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"eMail subject: Renovation of Teear Manor.\r\nDate: June 21st\r\n\r\nDear Residents and Business Owners of Namara,\r\n\r\nWe at Global Resorts, Exploration & Entertainment Developments are thrilled to be moving into the premises currently known as Teear Manor situated at 33-63 High Street.\r\n\r\nAs the new occupants of the Manor, we are excited to share our plans to renew this beautiful landmark:\r\nThe ground floor will become a bustling shopping suite.\r\nThe first floor will include a state of the art cinema.\r\nThe remaining upper floors will become luxury apartments. \r\n\r\nWork will commence in two days on June 23rd. The project is expected to be completed by Christmas.\r\n\r\nWe look forward to sharing in the delight of your small town.\r\n\r\nYours faithfully,\r\n\r\nE. Kzec\r\nProject Manager\r\nGlobal Resorts, Exploration & Entertainment Developments - North Division","wrap":true,"x":44.0,"y":97.5,},
