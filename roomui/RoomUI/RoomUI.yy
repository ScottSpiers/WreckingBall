        {"$GMRFlexPanel":"","%Name":"pnl_emailStart","alignItems":2,"children":[
            {"$GMRTextItem":"v3","%Name":"text_4D5A35A0","alignment":0,"charSpacing":0.0,"colour":4279834905,"flexProperties":{"$InstanceFlexProps":"v1","anchor":0,"resourceType":"InstanceFlexProps",},"fontId":{"name":"fnt_Serif","path":"fonts/fnt_Serif/fnt_Serif.yy",},"frameH":600.0,"frameW":1080.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_4D5A35A0","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"eMail subject: Renovation of Teear Manor Beginning in 2 Days.\r\nDate: June 21st\r\n\r\nDear Residents and Business Owners of Namara,\r\n\r\nWe at Global Resorts, Exploration & Entertainment Developments are thrilled to be moving into the premises currently known as Teear Manor situated at 33-63 High Street.\r\n\r\nAs the new occupants of the Manor, we are excited to share our plans to renew this beautiful landmark:\r\n- The ground floor will become a bustling shopping suite.\r\n- The first floor will include a state of the art cinema.\r\n- The remaining upper floors will become luxury apartments. \r\n\r\nWork will commence in two days on June 23rd. The project is expected to be completed by Christmas.\r\n\r\nWe look forward to sharing in the delight of your small town.\r\n\r\nYours faithfully,\r\n\r\nE. Kzec\r\nProject Manager\r\nGlobal Resorts, Exploration & Entertainment Developments - North Division","wrap":true,"x":44.0,"y":97.5,},
            {"$GMRSpriteGraphic":"v1","%Name":"graphic_45EB7C71","animationSpeed":1.0,"colour":4294967295,"flexProperties":{"$InstanceFlexProps":"v1","anchor":0,"resourceType":"InstanceFlexProps",},"frozen":false,"headPosition":0.0,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"name":"graphic_45EB7C71","resourceType":"GMRSpriteGraphic","resourceVersion":"2.0","rotation":0.0,"scaleX":3.0,"scaleY":3.0,"spriteId":{"name":"spr_Cross_CloseEmail","path":"sprites/spr_Cross_CloseEmail/spr_Cross_CloseEmail.yy",},"x":1104.5,"y":14.0,},
            {"$GMRSpriteGraphic":"v1","%Name":"graphic_1F830BFB","animationSpeed":1.0,"colour":4294967295,"flexProperties":{"$InstanceFlexProps":"v1","anchor":0,"resourceType":"InstanceFlexProps",},"frozen":false,"headPosition":0.0,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"name":"graphic_1F830BFB","resourceType":"GMRSpriteGraphic","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"spriteId":{"name":"spr_EmailBackground","path":"sprites/spr_EmailBackground/spr_EmailBackground.yy",},"x":0.0,"y":0.0,},
          ],"flexDirection":0,"height":{"unit":3,"value":700.0,},"justifyContent":1,"name":"pnl_emailStart","nodeColour":4294082376,"resourceType":"GMRFlexPanel","resourceVersion":"2.0","width":{"unit":3,"value":1167.0,},},
        {"$GMRFlexPanel":"","%Name":"pnl_emailEnd","alignItems":2,"children":[
            {"$GMRTextItem":"v3","%Name":"text_201702D4","alignment":0,"charSpacing":0.0,"colour":4279834905,"flexProperties":{"$InstanceFlexProps":"v1","anchor":0,"resourceType":"InstanceFlexProps",},"fontId":{"name":"fnt_Serif","path":"fonts/fnt_Serif/fnt_Serif.yy",},"frameH":600.0,"frameW":1080.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_201702D4","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"Dear valued Namara community member,\r\n\r\nWe greatly appreciate your dedication to the town, your town. \r\n\r\nIn reviewing your petition, we were overwhelmed by the responses (3500!) from the community and have chosen to reject Global Resort, Entertainment & Exploration Developments' plans to repurpose Teear Manor. \r\n\r\nWe wish to ensure that the town continues to thrive as a haven for those looking for respite, a moment's pause from the hustle and bustle. Therefore, the council will dedicate resources to reopening Teear Manor as a tourist and community centre.\r\n\r\nThanks for playing! Created for the GMTK Game Jam July 2026. Theme: Count Down.\r\n\r\nCredits:\r\nRachel Kneller - Narrative\r\nScott Spiers - Code\r\nMusic by Eric Matyas (www.soundimage.org)","wrap":true,"x":44.0,"y":97.5,},
            {"$GMRSpriteGraphic":"v1","%Name":"graphic_DE8F3BB","animationSpeed":1.0,"colour":4294967295,"flexProperties":{"$InstanceFlexProps":"v1","anchor":0,"resourceType":"InstanceFlexProps",},"frozen":false,"headPosition":0.0,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"name":"graphic_DE8F3BB","resourceType":"GMRSpriteGraphic","resourceVersion":"2.0","rotation":0.0,"scaleX":3.0,"scaleY":3.0,"spriteId":{"name":"spr_Cross_CloseEmail","path":"sprites/spr_Cross_CloseEmail/spr_Cross_CloseEmail.yy",},"x":1104.5,"y":14.0,},
            {"$GMRSpriteGraphic":"v1","%Name":"graphic_430431D","animationSpeed":1.0,"colour":4294967295,"flexProperties":{"$InstanceFlexProps":"v1","anchor":0,"resourceType":"InstanceFlexProps",},"frozen":false,"headPosition":0.0,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"name":"graphic_430431D","resourceType":"GMRSpriteGraphic","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"spriteId":{"name":"spr_EmailBackground","path":"sprites/spr_EmailBackground/spr_EmailBackground.yy",},"x":0.0,"y":0.0,},
          ],"flexDirection":0,"height":{"unit":3,"value":700.0,},"justifyContent":1,"name":"pnl_emailEnd","nodeColour":4294082376,"resourceType":"GMRFlexPanel","resourceVersion":"2.0","width":{"unit":3,"value":1167.0,},},
        {"$GMRFlexPanel":"","%Name":"pnl_playerPrompt","alignItems":2,"children":[
            {"$GMRTextItem":"v3","%Name":"text_16FD868E","alignment":1,"charSpacing":0.0,"colour":4294967295,"flexProperties":{"$InstanceFlexProps":"v1","anchor":0,"resourceType":"InstanceFlexProps",},"fontId":{"name":"fnt_default","path":"fonts/fnt_default/fnt_default.yy",},"frameH":200.0,"frameW":1080.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_16FD868E","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"Putting the knowledge you've scraped from YouTube to good use, you throw together a leaflet, complete with a QR code and petition website. You print several dozen, dust off your trusty clipboard and make your way to town to begin collecting signatures...\r\n","wrap":true,"x":0.0,"y":0.0,},
          ],"flexDirection":0,"height":{"unit":3,"value":32.0,},"justifyContent":1,"name":"pnl_playerPrompt","nodeColour":4282970801,"positionType":2,"resourceType":"GMRFlexPanel","resourceVersion":"2.0","width":{"unit":3,"value":96.0,},},
