            {"$GMRTextItem":"v3","%Name":"txt_tooltip","alignment":257,"charSpacing":0.0,"colour":4278190080,"flexProperties":{"$InstanceFlexProps":"v1","anchor":4,"resourceType":"InstanceFlexProps",},"fontId":{"name":"fnt_default","path":"fonts/fnt_default/fnt_default.yy",},"frameH":40.0,"frameW":40.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"txt_tooltip","origin":4,"paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":0.85,"scaleY":0.85,"text":"E","wrap":false,"x":0.0,"y":0.5,},
            {"$GMRSpriteGraphic":"v1","%Name":"graphic_397DD801","animationSpeed":1.0,"colour":4294967295,"flexProperties":{"$InstanceFlexProps":"v1","anchor":0,"resourceType":"InstanceFlexProps",},"frozen":false,"headPosition":0.0,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"name":"graphic_397DD801","resourceType":"GMRSpriteGraphic","resourceVersion":"2.0","rotation":0.0,"scaleX":0.33,"scaleY":1.0,"spriteId":{"name":"spr_PlayerPrompts","path":"sprites/spr_PlayerPrompts/spr_PlayerPrompts.yy",},"x":0.0,"y":0.0,},
