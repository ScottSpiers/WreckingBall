        {"$GMRFlexPanel":"","%Name":"pnl_email_Start","alignItems":2,"children":[
            {"$GMRTextItem":"v3","%Name":"text_4D5A35A0","alignment":0,"charSpacing":0.0,"colour":4279834905,"flexProperties":{"$InstanceFlexProps":"v1","anchor":0,"resourceType":"InstanceFlexProps",},"fontId":{"name":"fnt_Serif","path":"fonts/fnt_Serif/fnt_Serif.yy",},"frameH":600.0,"frameW":1080.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_4D5A35A0","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"eMail subject: Renovation of Teear Manor.\r\nDate: June 21st\r\n\r\nDear Residents and Business Owners of Namara,\r\n\r\nWe at Global Resorts, Exploration & Entertainment Developments are thrilled to be moving into the premises currently known as Teear Manor situated at 33-63 High Street.\r\n\r\nAs the new occupants of the Manor, we are excited to share our plans to renew this beautiful landmark:\r\nThe ground floor will become a bustling shopping suite.\r\nThe first floor will include a state of the art cinema.\r\nThe remaining upper floors will become luxury apartments. \r\n\r\nWork will commence in two days on June 23rd. The project is expected to be completed by Christmas.\r\n\r\nWe look forward to sharing in the delight of your small town.\r\n\r\nYours faithfully,\r\n\r\nE. Kzec\r\nProject Manager\r\nGlobal Resorts, Exploration & Entertainment Developments - North Division","wrap":true,"x":44.0,"y":97.5,},
            {"$GMRSpriteGraphic":"v1","%Name":"graphic_45EB7C71","animationSpeed":1.0,"colour":4294967295,"flexProperties":{"$InstanceFlexProps":"v1","anchor":0,"resourceType":"InstanceFlexProps",},"frozen":false,"headPosition":0.0,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"name":"graphic_45EB7C71","resourceType":"GMRSpriteGraphic","resourceVersion":"2.0","rotation":0.0,"scaleX":3.0,"scaleY":3.0,"spriteId":{"name":"spr_Cross_CloseEmail","path":"sprites/spr_Cross_CloseEmail/spr_Cross_CloseEmail.yy",},"x":1104.5,"y":14.0,},
            {"$GMRSpriteGraphic":"v1","%Name":"graphic_1F830BFB","animationSpeed":1.0,"colour":4294967295,"flexProperties":{"$InstanceFlexProps":"v1","anchor":0,"resourceType":"InstanceFlexProps",},"frozen":false,"headPosition":0.0,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"name":"graphic_1F830BFB","resourceType":"GMRSpriteGraphic","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"spriteId":{"name":"spr_EmailBackground","path":"sprites/spr_EmailBackground/spr_EmailBackground.yy",},"x":0.0,"y":0.0,},
